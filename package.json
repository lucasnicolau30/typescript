{
  "name": "typescript-estudos",
  "version": "1.0.0",
  "description": "Repositório de estudos de TypeScript (tipagem, funções, generics, utility types) com um exemplo básico de API Express.",
  "license": "ISC",
  "author": "Lucas",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "nodemon --exec \"ts-node --project tsconfig.json --esm\" src/index.ts"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
